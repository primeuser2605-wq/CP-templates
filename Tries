#include <bits/stdc++.h>
using namespace std;

struct TrieNode{
    TrieNode* child[26];
    int prefixCount;
    int endCount;

    TrieNode(){
        for(int i=0;i<26;i++)
            child[i]=NULL;

        prefixCount=0;
        endCount=0;
    }
};

class Trie{

public:

    TrieNode* root;

    Trie(){
        root=new TrieNode();
    }

    // Insert a word
    void insert(string word){

        TrieNode* node=root;

        for(char ch:word){

            int idx=ch-'a';

            if(node->child[idx]==NULL)
                node->child[idx]=new TrieNode();

            node=node->child[idx];
            node->prefixCount++;
        }

        node->endCount++;
    }

    // Search complete word
    bool search(string word){

        TrieNode* node=root;

        for(char ch:word){

            int idx=ch-'a';

            if(node->child[idx]==NULL)
                return false;

            node=node->child[idx];
        }

        return node->endCount>0;
    }

    // Check whether prefix exists
    bool startsWith(string prefix){

        TrieNode* node=root;

        for(char ch:prefix){

            int idx=ch-'a';

            if(node->child[idx]==NULL)
                return false;

            node=node->child[idx];
        }

        return true;
    }

    // Count exact occurrences of a word
    int countWordsEqualTo(string word){

        TrieNode* node=root;

        for(char ch:word){

            int idx=ch-'a';

            if(node->child[idx]==NULL)
                return 0;

            node=node->child[idx];
        }

        return node->endCount;
    }

    // Count words having given prefix
    int countWordsStartingWith(string prefix){

        TrieNode* node=root;

        for(char ch:prefix){

            int idx=ch-'a';

            if(node->child[idx]==NULL)
                return 0;

            node=node->child[idx];
        }

        return node->prefixCount;
    }

    // Erase one occurrence of a word
    void erase(string word){

        TrieNode* node=root;

        for(char ch:word){

            int idx=ch-'a';

            if(node->child[idx]==NULL)
                return;

            node=node->child[idx];
            node->prefixCount--;
        }

        node->endCount--;
    }
};
