ll merge_sort(vector<int>&a,int l,int r){
    if(l>=r) return 0;

    int mid=(l+r)/2;

    ll inv=0;
    inv+=merge_sort(a,l,mid);
    inv+=merge_sort(a,mid+1,r);

    vector<int>temp;
    int i=l,j=mid+1;

    while(i<=mid&&j<=r){
        if(a[i]<=a[j]){
            temp.push_back(a[i++]);
        }else{
            inv+=(mid-i+1);
            temp.push_back(a[j++]);
        }
    }

    while(i<=mid) temp.push_back(a[i++]);
    while(j<=r) temp.push_back(a[j++]);

    for(int k=l;k<=r;k++)
        a[k]=temp[k-l];

    return (inv%2);
}
