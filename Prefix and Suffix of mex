#include <bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;cin>>n;
    vector<int>a(n);
    for(int i=0;i<n;i++)cin>>a[i];

    vector<int>prefMex(n),suffMex(n);
    vector<int>cnt(n+2,0);

    int mex=0;
    for(int i=0;i<n;i++){
        if(a[i]<=n)cnt[a[i]]++;
        while(cnt[mex]>0)mex++;
        prefMex[i]=mex;
    }

    fill(cnt.begin(),cnt.end(),0);
    mex=0;

    for(int i=n-1;i>=0;i--){
        if(a[i]<=n)cnt[a[i]]++;
        while(cnt[mex]>0)mex++;
        suffMex[i]=mex;
    }

    for(int i=0;i<n;i++)cout<<prefMex[i]<<" ";
    cout<<"\n";
    for(int i=0;i<n;i++)cout<<suffMex[i]<<" ";
}
