#include <bits/stdc++.h>
using namespace std;
#define int long long

vector<vector<int>> adj;
vector<int> vis,tin,low;
vector<pair<int,int>> bridges;
int timer=0;

void dfs(int u,int p){
    vis[u]=1;
    tin[u]=low[u]=++timer;

    for(int v:adj[u]){
        if(v==p) continue;

        if(vis[v]){
            low[u]=min(low[u],tin[v]);
        }else{
            dfs(v,u);

            low[u]=min(low[u],low[v]);

            if(low[v]>tin[u]){
                bridges.push_back({u,v});
            }
        }
    }
}

signed main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n,m;
    cin>>n>>m;

    adj.resize(n+1);
    vis.resize(n+1,0);
    tin.resize(n+1);
    low.resize(n+1);

    for(int i=0;i<m;i++){
        int u,v;
        cin>>u>>v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    for(int i=1;i<=n;i++){
        if(!vis[i]){
            dfs(i,-1);
        }
    }

    cout<<"Bridges:\n";

    for(auto [u,v]:bridges){
        cout<<u<<" "<<v<<"\n";
    }

    return 0;
}
